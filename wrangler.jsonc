{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leanwise-ai",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }

  /* Bindings — uncomment as you provision them in Cloudflare:

  "vars": {
    "PUBLIC_GA_ID": "",
    "PUBLIC_META_PIXEL_ID": "",
    "RESEND_FROM": "hello@leanwise.ai",
    "RESEND_TO": "support@leanwise.ai"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "leanwise-ai", "database_id": "TODO" }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "TODO" }
  ],

  "send_email": [
    { "name": "MAIL", "destination_address": "support@leanwise.ai" }
  ]
  */

  /* Secrets (set via `wrangler secret put RESEND_API_KEY`):
     - RESEND_API_KEY
  */
}
