{
  "name": "leanwise-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview",
    "wrangler:dev": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "db:setup": "wrangler d1 execute leanwise-ai --local --file=db/schema.sql",
    "lint": "tsc --noEmit",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:remote": "BASE_URL=https://leanwise-ai.nthanhtrung198.workers.dev playwright test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.131.0",
    "@tanstack/react-start": "^1.131.0",
    "jose": "^6.2.3",
    "marked": "^18.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0",
    "wrangler": "^4.87.0"
  }
}
