# LeanWise AI — environment variables
# Copy to .env (local dev) or .dev.vars (Wrangler dev).

# Form delivery — at least one is required for forms to actually send.
# Option A: Resend (recommended)
RESEND_API_KEY=
RESEND_FROM=hello@leanwise.ai
RESEND_TO=support@leanwise.ai

# Option B: Cloudflare Email Workers (no key needed; bind via wrangler.jsonc)
# Uses the MAIL binding declared in wrangler.jsonc → no env vars here.

# Public analytics IDs (exposed to browser; safe to commit blank values)
PUBLIC_GA_ID=
PUBLIC_META_PIXEL_ID=

# Optional: where to point newsletter signups (Mailchimp/Buttondown/etc).
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
